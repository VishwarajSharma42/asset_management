# /etc/dsoreg/backend.env — generated by scripts/gen_keys.py. This file is a map of the variables,
# with NO real values. Mode 640 root:dsoreg. The KEK is deliberately not here (see docs/DEPLOY.md).
DSOREG_ENV=production
DATABASE_URL=postgresql+psycopg://dsoreg_app:<password>@/dsoreg
PUBLIC_HOST=assets.college.example           # baked into every tag; never change on a live system
MEDIA_DIR=/var/lib/dsoreg/media
TRUST_PROXY_HOPS=1                           # nginx in front
LOCATION_REQUIRED=0                           # 1 = refuse usage entries that arrive without a phone location
SCAN_ALLOWED_CIDRS=                          # optional: e.g. 10.0.0.0/8,192.168.0.0/16 (campus only)

FIELD_RECIPIENT_KEY_WRAPPED=<hex>            # X25519 private, wrapped under the KEK
FIELD_RECIPIENT_PUB=<64 hex>                 # also goes in the Pi's config.toml
ROW_SIGNING_KEY_WRAPPED=<hex>
ROW_SIGNING_PUBKEY=<64 hex>
SESSION_SIGNING_KEY_WRAPPED=<hex>
SESSION_SIGNING_PUBKEY=<64 hex>
TICKET_KEY_HEX=<64 hex>
TAG_INDEX_KEY_HEX=<64 hex>
TAG_KEY_HEX=<32 hex>                         # 16 bytes; also on the Pi (tag.key). Not rotatable for written tags.
IP_HASH_SEED_HEX=<64 hex>

# optional tuning
TICKET_TTL_S=1800
SESSION_TTL_S=1800
DEVICE_DAILY_ENROL_LIMIT=300
