# Copy to the repository root as `.env` (git-ignored) and fill in.
# Use hex passwords (openssl rand -hex 24): they go into a URL, so no special characters.

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=          # must be the same password that is inside DATABASE_URL in secrets.docker/backend.env

HTTP_PORT=80
HTTPS_PORT=443            # the http->https redirect assumes 443, so change this for testing only

# Leave empty while testing: a browser remembers HSTS for the host name for a year.
# On the real server:  HSTS_VALUE=max-age=31536000; includeSubDomains
HSTS_VALUE=
