# The Flask API under gunicorn. Build context is the repository root (see docker-compose.yml).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

RUN useradd --system --uid 10001 --no-create-home dsoreg \
 && mkdir -p /var/lib/dsoreg/media \
 && chown dsoreg:dsoreg /var/lib/dsoreg/media

WORKDIR /srv/dsoreg/backend
COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/dsoreg ./dsoreg

USER dsoreg
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=4s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=3)"

# Same worker settings as deploy/dsoreg.service; the rate limiter lives in the database, so the
# limits mean what they say however many workers run.
CMD ["gunicorn", "--workers", "2", "--threads", "4", "--timeout", "40", \
     "--bind", "0.0.0.0:8000", "--worker-tmp-dir", "/dev/shm", "--no-control-socket", "dsoreg.app:wsgi()"]
